---
/** Centred title + lede on a dotted band. Put MetaList / buttons in the slot. */
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}
const { title, lede, eyebrow } = Astro.props;
---

<section class="ch">
  <div class="container ch__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .ch { position: relative; isolation: isolate; padding-block: var(--s-16) var(--s-12); }
  /* Dotted band fades out at the bottom; on a pseudo-element so the mask never touches the content */
  .ch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--surface);
    background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1.2px);
    background-size: 18px 18px;
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }
  .ch__inner { display: grid; gap: var(--s-5); justify-items: center; text-align: center; }
  h1 { font-size: var(--fs-display); line-height: var(--lh-tight); letter-spacing: -0.035em; font-weight: 750; max-width: 18ch; }
  .lede { margin-inline: auto; }
</style>
