---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '@kit/layout/Section.astro';
import SectionHeading from '@kit/layout/SectionHeading.astro';
import PostGrid from '@kit/blog/PostGrid.astro';
import PostBrowser from '@kit/blog/PostBrowser.astro';
import { posts } from '@data/posts';

const sorted = [...posts].sort((a, b) => +b.pubDate - +a.pubDate);
---

<BaseLayout title="Blog" description="Write-ups on Veeam, data, automation and AI.">
  <Section space="sm">
    <div class="intro">
      <SectionHeading
        level={1}
        size="display"
        title="Notes on backup data, APIs and the AI built on top"
        lede="Practical write-ups from the field: Veeam APIs, MCP servers, security, and the people side of technology."
      />
    </div>
    <PostGrid posts={sorted.slice(0, 3)} eagerFirst={3} />
  </Section>

  <Section aria-labelledby="all-posts">
    <SectionHeading id="all-posts" title="All posts" />
    <PostBrowser posts={sorted} pageSize={6} />
  </Section>
</BaseLayout>

<style>
  .intro { padding-top: var(--s-8); }
</style>
