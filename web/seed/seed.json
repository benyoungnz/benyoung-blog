{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "benyoung.blog",
		"description": "Ben Young's blog: posts, categories, tags, on the site-kit theme",
		"author": "Ben Young"
	},
	"settings": {
		"title": "Ben Young",
		"tagline": "Notes on Veeam, data, automation and the AI that runs on top of it.",
		"timezone": "Pacific/Auckland"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/blog/{slug}/",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"commentsEnabled": false,
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{ "slug": "description", "label": "Description", "type": "text", "required": true, "searchable": true },
				{ "slug": "featured_image", "label": "Hero image", "type": "image" },
				{ "slug": "cover_title", "label": "Cover title (short title on the typographic cover when there is no image)", "type": "string" },
				{ "slug": "content", "label": "Content", "type": "portableText", "searchable": true },
				{ "slug": "updated_date", "label": "Updated date (shown as \"Updated\" on the post)", "type": "datetime" },
				{ "slug": "legacy_path", "label": "Legacy path (old URL, for redirects)", "type": "string" }
			]
		},
		{
			"slug": "videos",
			"label": "Videos",
			"labelSingular": "Video",
			"urlPattern": "/videos/{slug}/",
			"supports": ["drafts", "search"],
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{ "slug": "youtube_id", "label": "YouTube video ID", "type": "string", "required": true, "unique": true },
				{ "slug": "description", "label": "Description", "type": "text", "searchable": true },
				{ "slug": "published_on", "label": "Published on YouTube", "type": "datetime", "required": true },
				{ "slug": "is_short", "label": "YouTube Short", "type": "boolean" }
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{ "slug": "veeam", "label": "Veeam" },
				{ "slug": "ai", "label": "AI" },
				{ "slug": "tfd", "label": "Tech Field Day" },
				{ "slug": "infrastructure", "label": "Infrastructure" },
				{ "slug": "security", "label": "Security" },
				{ "slug": "ransomware", "label": "Ransomware" },
				{ "slug": "veeam-data-cloud", "label": "Veeam Data Cloud" },
				{ "slug": "random", "label": "Random" }
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": []
		}
	],
	"bylines": [
		{
			"id": "byline-ben",
			"slug": "ben-young",
			"displayName": "Ben Young",
			"bio": "Field CTO, APJ at Veeam and 5x Veeam Vanguard. I build things on top of backup data and write about what I learn: APIs, MCP servers, security and the people side of tech.",
			"websiteUrl": "https://benyoung.blog/about/"
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Blog", "url": "/blog/" },
				{ "type": "custom", "label": "Videos", "url": "/videos/" },
				{ "type": "custom", "label": "Tags", "url": "/tags/" },
				{ "type": "custom", "label": "About", "url": "/about/" }
			]
		}
	]
}
