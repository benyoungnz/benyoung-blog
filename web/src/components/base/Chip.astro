---
import type { Tone } from '@data/types';

/**
 * Pill used for tags, filters and category nav.
 * - href → link, otherwise a toggle <button> (aria-pressed reflects `active`).
 * - tone adds a coloured dot; count adds a trailing number.
 * - static → plain <span> label, not interactive.
 */
interface Props {
  href?: string;
  active?: boolean;
  tone?: Tone;
  count?: number;
  size?: 'sm' | 'md';
  static?: boolean;
  [attr: `data-${string}`]: string | undefined;
}

const { href, active = false, tone, count, size = 'md', static: isStatic, ...data } = Astro.props;
const Tag = isStatic ? 'span' : href ? 'a' : 'button';
---

<Tag
  href={href}
  type={Tag === 'button' ? 'button' : undefined}
  aria-pressed={Tag === 'button' ? (active ? 'true' : 'false') : undefined}
  class:list={['chip', `chip--${size}`, { 'is-active': active, 'chip--static': isStatic }]}
  style={tone ? `--dot: var(--deep-${tone}); --soft: var(--tint-${tone})` : undefined}
  {...data}
>
  {tone && <span class="chip__dot" aria-hidden="true" />}
  <slot />
  {count !== undefined && <span class="chip__count">{count}</span>}
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink-2);
    border-radius: var(--r-pill);
    font-weight: 550;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .chip--sm { font-size: var(--fs-xs); padding: 0.4rem 0.7rem; }
  .chip--md { font-size: var(--fs-sm); padding: 0.55rem 0.95rem; }

  .chip:not(.chip--static):hover { border-color: var(--ink); color: var(--ink); }
  .chip.is-active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .chip.is-active .chip__count { color: var(--mint); }

  .chip__dot { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--dot); }
  .chip__count { color: var(--ink-3); font-variant-numeric: tabular-nums; font-size: 0.9em; }
</style>
