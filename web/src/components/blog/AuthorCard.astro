---
import Avatar from '../base/Avatar.astro';
import Icon from '../base/Icon.astro';
import type { Author } from '@data/types';

interface Props {
  author: Author;
  label?: string;
}
const { author, label = 'Written by' } = Astro.props;
---

<section class="ac" aria-label={label}>
  <p class="eyebrow">{label}</p>
  <div class="ac__card">
    <Avatar src={author.avatar} alt="" size={72} />
    <div class="ac__text">
      <p class="ac__name">{author.name}</p>
      <p class="ac__role">{author.role}</p>
      {author.bio && <p class="ac__bio">{author.bio}</p>}
      {author.href && <a class="ac__link" href={author.href}>More about {author.name.split(' ')[0]} <Icon name="arrow-right" size={16} /></a>}
    </div>
  </div>
</section>

<style>
  .ac { display: grid; gap: var(--s-3); padding-top: var(--s-10); margin-top: var(--s-12); border-top: 1px solid var(--line); max-width: var(--measure); }
  .ac__card { display: flex; gap: var(--s-5); align-items: flex-start; padding: var(--s-6); border: 1px solid var(--line); border-radius: var(--r-xl); background: var(--paper); box-shadow: var(--shadow-card); }
  .ac__text { display: grid; gap: var(--s-1); }
  .ac__name { font-family: var(--font-display); font-weight: 750; font-size: 1.25rem; color: var(--ink); }
  .ac__role { font-size: var(--fs-sm); color: var(--ink-3); }
  .ac__bio { margin-top: var(--s-2); color: var(--ink-2); font-size: 0.9375rem; }
  .ac__link { display: inline-flex; align-items: center; gap: var(--s-1); margin-top: var(--s-2); font-size: var(--fs-sm); font-weight: 600; color: var(--brand-ink); text-decoration: none; }
  .ac__link:hover { color: var(--ink); }
  @media (max-width: 519px) { .ac__card { flex-direction: column; } }
</style>
