---
import { Image } from 'emdash/ui';
import { toneFor, type Post } from '@data/types';

/**
 * Photo cover when the post has heroImage; otherwise a typographic cover:
 * tint + soft rings + the short coverTitle in the display face.
 */
interface Props {
  post: Pick<Post, 'slug' | 'title' | 'heroImage' | 'image' | 'coverTitle' | 'tone'>;
  size?: 'card' | 'hero';
  eager?: boolean;
}
const { post, size = 'card', eager = false } = Astro.props;
const tone = post.tone ?? toneFor(post.slug);
const hasImage = Boolean(post.image || post.heroImage);
// Cards sit in a 3/2/1-column grid; the hero spans the article column
const sizes = size === 'hero' ? '(min-width: 1000px) 760px, 100vw' : '(min-width: 1000px) 380px, (min-width: 640px) 50vw, 100vw';
---

<div class:list={['cover', `cover--${size}`, { 'cover--type': !hasImage }]} style={`--soft: var(--tint-${tone}); --deep: var(--deep-${tone})`}>
  {
    post.image ? (
      <Image image={post.image} alt="" sizes={sizes} priority={eager} />
    ) : post.heroImage ? (
      <img src={post.heroImage} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
    ) : (
      <>
        <span class="cover__rings" aria-hidden="true" />
        <span class="cover__title" aria-hidden="true">{post.coverTitle ?? post.title}</span>
        <img class="cover__mark" src="/logo.svg" alt="" width="22" height="28" />
      </>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 1.9 / 1;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--soft);
    border: 1px solid color-mix(in srgb, var(--deep) 14%, transparent);
    isolation: isolate;
  }
  .cover--hero { border-radius: var(--r-xl); }
  .cover :global(img:not(.cover__mark)) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }

  .cover--type { display: flex; align-items: flex-end; padding: 7% 8%; }
  .cover__title {
    position: relative;
    max-width: 16ch;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.2rem, 0.9rem + 1.2vw, 1.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cover--hero .cover__title { font-size: clamp(1.8rem, 1rem + 3vw, 3rem); }
  .cover__rings {
    position: absolute;
    right: -12%;
    top: -30%;
    width: 70%;
    aspect-ratio: 1;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 38%, color-mix(in srgb, var(--deep) 18%, transparent) 38.5% 40%, transparent 40.5%),
      radial-gradient(circle, color-mix(in srgb, var(--paper) 55%, transparent) 0 30%, transparent 30.5%),
      radial-gradient(circle, transparent 55%, color-mix(in srgb, var(--deep) 12%, transparent) 55.5% 57%, transparent 57.5%);
  }
  .cover__mark { position: absolute; top: 8%; left: 8%; width: 22px; opacity: 0.85; }
</style>
