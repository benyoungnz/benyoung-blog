---
/** Checklist with filled number markers: bold lead + explanation. `text` accepts HTML. */
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<ol class="nl">
  {items.map((i) => (
    <li><p><strong>{i.title}</strong> <span set:html={i.text} /></p></li>
  ))}
</ol>

<style>
  .nl { display: grid; gap: var(--s-5); list-style: none; padding: 0; counter-reset: nl; }
  li { counter-increment: nl; display: grid; grid-template-columns: 28px 1fr; gap: var(--s-4); align-items: start; color: var(--ink-2); }
  li::before {
    content: counter(nl);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-top: 0.05em;
    border-radius: 50%;
    background: var(--ink);
    color: var(--mint);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--fs-sm);
  }
  strong { color: var(--ink); }
  li :global(a) { color: var(--ink); text-decoration-thickness: 2px; text-decoration-color: var(--deep-mint); }
</style>
