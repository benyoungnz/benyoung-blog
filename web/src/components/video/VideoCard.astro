---
/** Video card: 16:9 thumbnail with play badge → date · views → title. Same rhythm as PostCard. */
import Icon from '@kit/base/Icon.astro';
import { formatDate, isoDate } from '@data/format';
import { formatViews, videoHref, type Video } from '@lib/youtube';

interface Props {
  video: Video;
  headingLevel?: 2 | 3;
  eager?: boolean;
}
const { video, headingLevel = 3, eager = false } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const views = formatViews(video.views);
---

<article class="vcard">
  <div class="vcard__thumb">
    <img src={video.thumbnail} alt="" width="320" height="180" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class="vcard__play" aria-hidden="true"><Icon name="play" size={20} /></span>
    {video.short && <span class="vcard__badge">Short</span>}
  </div>
  <div class="vcard__body">
    <p class="vcard__meta">
      <time datetime={isoDate(video.published)}>{formatDate(video.published)}</time>
      {views && <span>{views}</span>}
    </p>
    <H class="vcard__title"><a href={videoHref(video.id)}>{video.title}</a></H>
  </div>
</article>

<style>
  .vcard { position: relative; display: grid; gap: var(--s-4); align-content: start; }
  .vcard__thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--ink);
    border: 1px solid var(--line);
  }
  .vcard__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }
  .vcard__play {
    position: absolute;
    left: var(--s-4);
    bottom: var(--s-4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--ink);
    box-shadow: var(--shadow-card);
    transition: transform var(--dur) var(--ease);
  }
  .vcard__play :global(svg) { margin-left: 2px; fill: currentColor; }
  .vcard__badge {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 650;
  }
  .vcard__body { display: grid; gap: var(--s-2); }
  .vcard__meta { display: flex; gap: var(--s-3); font-size: var(--fs-sm); color: var(--ink-3); }
  .vcard__meta span::before { content: '·'; margin-right: var(--s-3); }
  .vcard__title { font-size: clamp(1.15rem, 1.05rem + 0.3vw, 1.3rem); line-height: 1.25; }
  .vcard__title a { text-decoration: none; background: linear-gradient(var(--mint), var(--mint)) 0 100% / 0 3px no-repeat; transition: background-size 220ms var(--ease); }
  .vcard__title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--r-lg); }
  .vcard:hover .vcard__title a { background-size: 100% 3px; }
  .vcard:hover .vcard__thumb img { transform: scale(1.04); }
  .vcard:hover .vcard__play { transform: scale(1.08); }
  .vcard:has(a:focus-visible) { outline: 2px solid var(--pop); outline-offset: 6px; border-radius: var(--r-lg); }
  .vcard a:focus-visible { outline: none; }
</style>
