---
import '@styles/base.css';
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from 'emdash';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import { createPublicPageContext } from 'emdash/page';
import SiteHeader from '@kit/layout/SiteHeader.astro';
import SiteFooter from '@kit/layout/SiteFooter.astro';
import { site, nav as defaultNav } from '@data/site';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string | null;
  modifiedTime?: string | null;
  /** Content reference, so plugins can contribute to content pages */
  content?: { collection: string; id: string; slug?: string | null };
  /** Extra schema.org objects for this page (VideoObject, BreadcrumbList, …) */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail for BreadcrumbList structured data; the last item is this page */
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, robots, type = 'website', publishedTime, modifiedTime, content, breadcrumbs } = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
// Pages without their own image share the branded card (scripts/og-image.ts renders it)
const image = Astro.props.image ?? `${origin}/og-default.png`;

const [settingsResult, menuResult] = await Promise.all([getSiteSettingsWithCacheHint(), getMenuWithCacheHint('primary')]);
if (Astro.cache?.enabled) {
  Astro.cache.set(settingsResult.cacheHint);
  Astro.cache.set(menuResult.cacheHint);
}

const siteName = settingsResult.data?.title || site.name;
const description = Astro.props.description ?? settingsResult.data?.tagline ?? site.tagline;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// Every public URL ends in a slash, matching the old site's indexed URLs
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname.replace(/\/?$/, '/'), origin).href;
const jsonLd = [
  ...(Astro.props.jsonLd ?? []),
  ...(breadcrumbs?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((b, i, all) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.label,
          item: new URL(i === all.length - 1 ? canonical : (b.href ?? '/'), origin).href,
        })),
      }]
    : []),
];
const menuItems = menuResult.data?.items ?? [];
const nav = menuItems.length ? menuItems.map((i) => ({ label: i.label, href: i.url })) : defaultNav;

const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType: type,
  title: fullTitle,
  pageTitle: title,
  description,
  canonical,
  image,
  content,
  seo: { ogImage: image, robots },
  articleMeta: { publishedTime, modifiedTime, author: type === 'article' ? 'Ben Young' : undefined },
  siteName,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <link rel="icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <EmDashBodyStart page={pageCtx} />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader nav={nav} siteName={siteName} />
    <main id="main"><slot /></main>
    <SiteFooter />
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>

<style>
  .skip { position: absolute; left: var(--s-4); top: -100px; z-index: 100; padding: var(--s-2) var(--s-4); background: var(--ink); color: var(--paper); border-radius: var(--r-md); }
  .skip:focus { top: var(--s-4); }
</style>
