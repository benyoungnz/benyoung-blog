---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermArchive from '../../components/site/TermArchive.astro';
import { allPosts, postsWithTerm, termIndex, toPost } from '@lib/content';

const slug = Astro.params.tag?.toLowerCase();
const entries = await allPosts(Astro);
const index = termIndex(entries, 'tag');
const term = index.find((t) => t.slug === slug);
if (!term) return Astro.rewrite('/404');
const posts = postsWithTerm(entries, 'tag', term.slug).map(toPost);
---

<BaseLayout title={`${term.label} posts`} description={`${posts.length} posts about ${term.label}.`} breadcrumbs={[{ label: 'Tags', href: '/tags/' }, { label: term.label }]}>
  <TermArchive term={term} posts={posts} others={index.filter((t) => t.slug !== term.slug)} base="/tags/" crumb="Tags" prefix="#" />
</BaseLayout>
